# Copie para .env e preencha. NUNCA versione o .env.

# --- banco ---
POSTGRES_USER=estoque
POSTGRES_PASSWORD=troque-isto
POSTGRES_DB=estoque
DATABASE_URL=postgresql+asyncpg://estoque:troque-isto@db:5432/estoque

# --- api ---
SESSAO_SECRET=gere-com-openssl-rand-hex-32
MODO_DEMO=true
CORS_ORIGIN=http://localhost:5173

# --- assistente ---
# Sem esta chave o assistente falha explicitamente. Ele NUNCA cai para o mock
# em silêncio: foi o erro central da POC v1 (ver docs/00-achados-v1.md).
ANTHROPIC_API_KEY=
MODELO_ASSISTENTE=claude-haiku-4-5-20251001
