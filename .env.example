# Copie para .env e preencha. NUNCA versione o .env.

# --- banco ---
POSTGRES_USER=estoque
POSTGRES_PASSWORD=troque-isto
POSTGRES_DB=estoque
DATABASE_URL=postgresql+asyncpg://estoque:troque-isto@db:5432/estoque

# --- api ---
SESSAO_SECRET=gere-com-openssl-rand-hex-32
MODO_DEMO=true
CORS_ORIGIN=http://localhost:5173

# --- assistente ---
# Sem chave o assistente falha EXPLICITAMENTE. Ele nunca cai para o mock em
# silêncio: foi o erro central da POC v1 (docs/00-achados-v1.md).
#
# PROVEDOR escolhe o adaptador SEM tocar em código:
#   openrouter   roteador multi-modelo (padrão) — usa OPENROUTER_API_KEY
#   compativel   QUALQUER API compatível com OpenAI, via LLM_BASE_URL:
#                Ollama, vLLM, Groq, Together, Azure, LM Studio
#   anthropic    SDK nativo — usa ANTHROPIC_API_KEY
#   mock         determinístico, só teste. NUNCA é escolhido sozinho
PROVEDOR=openrouter
OPENROUTER_API_KEY=
MODELO_ASSISTENTE=anthropic/claude-haiku-4.5

# Para PROVEDOR=compativel. Exemplo com Ollama na própria máquina:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1/chat/completions
#   LLM_API_KEY=ollama
#   MODELO_ASSISTENTE=qwen2.5:14b
LLM_BASE_URL=
LLM_API_KEY=

# Modelo alternativo medido pela suíte de avaliação (PRD §9)
MODELO_ALTERNATIVO=anthropic/claude-sonnet-4.6

# Como a saída é restringida, em ordem de suporte crescente:
#   restrito     response_format json_schema — o melhor, nem todo provedor tem
#   ferramenta   tool calling — suporte mais amplo
#   livre        JSON solto — funciona em qualquer lugar, e mede a pergunta
#                original da v1
# O adaptador CAI para o próximo se o provedor recusar, registrando qual valeu.
MODO_DECODIFICACAO=restrito

# --- observabilidade (opcional) ---
# Sem chave, o observador é nulo e o sistema segue. Diferente do modelo:
# telemetria ausente degrada o diagnóstico, modelo ausente falsifica o resultado.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
