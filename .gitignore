# Cache do grimp (import-linter). Fica de fora do versionamento e os testes de
# grafo o desligam explicitamente: ele ja' serviu um grafo velho depois de o
# import ter sido removido, e um cache que atrasa pode atrasar no outro sentido.
.grimp_cache/
node_modules/
dist/
coverage/

# Artefatos do Playwright (T-053): relatório, trace, vídeo e screenshot de
# falha. São saída de execução, e o CI os publica como artefato do job.
test-results/
playwright-report/
.DS_Store

# Skills instaladas por `npx skills add` ficam versionadas em .claude/skills/
# junto com skills-lock.json, para o time reproduzir a mesma versão.
# `npx skills add` recria .agents/ — mova para .claude/ e apague.
.agents/

# Material de divulgação: fica no projeto para quem edita achar, fora do git
# porque vídeo entra no histórico e não sai mais — e se regenera com
# `npx tsx web/scripts/capturar-marketing.ts` (docs/marketing/README.md).
docs/marketing/midia/
