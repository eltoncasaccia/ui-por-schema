[importlinter]
root_package = estoque
include_external_packages = True

# --- ADR-0007: camadas ---
[importlinter:contract:1]
name = domain nao depende de nada
type = forbidden
source_modules = estoque.domain
forbidden_modules =
    estoque.data
    estoque.server
    estoque.application.registry
    estoque.assistant
    estoque.application.commands
    estoque.auth
    sqlalchemy
    fastapi

# `registry` pode depender de `data.porta` (so' Protocol), nunca da implementacao
# nem do servidor. E' o que permite testar componente sem banco.
[importlinter:contract:2]
name = registry nao importa server nem sqlalchemy
type = forbidden
source_modules = estoque.application.registry
forbidden_modules =
    estoque.server
    sqlalchemy

# --- ADR-0002: a tese do projeto ---
# O pipeline do assistente NAO alcanca os comandos de escrita.
# Vale para import transitivo tambem — e por isso e' `forbidden`, nao `layers`.
[importlinter:contract:3]
name = assistente nunca alcanca comandos de escrita
type = forbidden
source_modules = estoque.assistant
forbidden_modules = estoque.application.commands
allow_indirect_imports = False

# --- ADR-0012: injecao de prompt via dado ---
[importlinter:contract:4]
name = prompt nao importa dados
type = forbidden
source_modules = estoque.assistant.prompt
forbidden_modules = estoque.data

# --- ADR-0032: a borda HTTP quebrada por area ---
# Um router que importa outro reconstroi o monolito por dentro: a rota de auth
# passaria a arrastar a de comandos, e o arquivo de 817 linhas voltaria dividido
# em oito pedacos que so' rodam juntos. O que os routers compartilham mora em
# `server/deps.py`, e e' de la' que vem — nunca do vizinho.
[importlinter:contract:5]
name = os routers da borda nao se importam
type = independence
modules =
    estoque.server.rotas.saude
    estoque.server.rotas.auth
    estoque.server.rotas.catalogo
    estoque.server.rotas.assistente
    estoque.server.rotas.views
    estoque.server.rotas.compartilhamento
    estoque.server.rotas.dados
    estoque.server.rotas.exportar
    estoque.server.rotas.comandos
    estoque.server.rotas.usuarios

# --- ADR-0035: a exportacao ---
# Quem decide O QUE vai no arquivo nao conhece o formato. Trocar openpyxl ou
# fpdf2 e' trocar adaptador; se `application` os importasse, seria mexer na
# regra que tira custo do arquivo.
[importlinter:contract:6]
name = exportacao da aplicacao nao conhece formato
type = forbidden
source_modules = estoque.application.exportacao
forbidden_modules =
    estoque.exportacao
    estoque.server
    openpyxl
    fpdf

# O assistente compoe tela; nao gera arquivo. Levar dado para fora do sistema
# nao pode estar a um import do pipeline do modelo.
[importlinter:contract:7]
name = assistente nao exporta
type = forbidden
source_modules = estoque.assistant
forbidden_modules =
    estoque.application.exportacao
    estoque.exportacao
allow_indirect_imports = False
