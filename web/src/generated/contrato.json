{
  "componentes": [
    {
      "id": "estoque_indicador",
      "label": "Indicador",
      "tamanho": "linha",
      "viewmodel": {
        "$defs": {
          "EstoqueIndicadorFaixa": {
            "description": "Um pedaco da decomposicao. `ordem` posiciona na rampa sequencial.",
            "properties": {
              "ordem": {
                "default": 0,
                "type": "integer"
              },
              "rotulo": {
                "type": "string"
              },
              "valor": {
                "type": "integer"
              }
            },
            "required": [
              "rotulo",
              "valor"
            ],
            "title": "EstoqueIndicadorFaixa",
            "type": "object"
          }
        },
        "properties": {
          "detalhe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "escopo": {
            "type": "string"
          },
          "faixas": {
            "default": [],
            "items": {
              "$ref": "#/$defs/EstoqueIndicadorFaixa"
            },
            "type": "array"
          },
          "metrica": {
            "enum": [
              "lotes_em_quarentena",
              "lotes_vencendo_90d",
              "lotes_bloqueados",
              "valor_em_estoque"
            ],
            "type": "string"
          },
          "rotulo": {
            "type": "string"
          },
          "tipo_faixa": {
            "default": "nenhum",
            "enum": [
              "urgencia",
              "unidade",
              "nenhum"
            ],
            "type": "string"
          },
          "unidade_medida": {
            "enum": [
              "lotes",
              "centavos"
            ],
            "type": "string"
          },
          "valor": {
            "type": "integer"
          }
        },
        "required": [
          "metrica",
          "rotulo",
          "valor",
          "unidade_medida",
          "escopo"
        ],
        "title": "VMEstoqueIndicador",
        "type": "object"
      }
    },
    {
      "id": "fila_vencimento",
      "label": "Fila de vencimento",
      "tamanho": "inteira",
      "viewmodel": {
        "$defs": {
          "FilaVencimentoFaixaResumo": {
            "description": "Uma faixa da rampa de urgencia. `ordem` cresce com a urgencia.",
            "properties": {
              "ordem": {
                "type": "integer"
              },
              "rotulo": {
                "type": "string"
              },
              "valor": {
                "type": "integer"
              }
            },
            "required": [
              "rotulo",
              "valor",
              "ordem"
            ],
            "title": "FilaVencimentoFaixaResumo",
            "type": "object"
          },
          "FilaVencimentoLinhaVencimento": {
            "properties": {
              "dias_restantes": {
                "type": "integer"
              },
              "lote_id": {
                "type": "string"
              },
              "numero": {
                "type": "string"
              },
              "produto": {
                "type": "string"
              },
              "saldo": {
                "type": "integer"
              },
              "situacao": {
                "enum": [
                  "ok",
                  "alerta_90",
                  "bloqueio_30",
                  "vencido"
                ],
                "type": "string"
              },
              "unidade": {
                "type": "string"
              },
              "validade": {
                "format": "date",
                "type": "string"
              }
            },
            "required": [
              "lote_id",
              "produto",
              "numero",
              "unidade",
              "validade",
              "dias_restantes",
              "saldo",
              "situacao"
            ],
            "title": "FilaVencimentoLinhaVencimento",
            "type": "object"
          }
        },
        "description": "O viewmodel. E' EXATAMENTE isto que atravessa a rede — nada de `Lote`,\nnada de linha de banco, nada de custo (ADR-0020, CA-05).",
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "janela_dias": {
            "type": "integer"
          },
          "linhas": {
            "items": {
              "$ref": "#/$defs/FilaVencimentoLinhaVencimento"
            },
            "type": "array"
          },
          "resumo": {
            "default": [],
            "items": {
              "$ref": "#/$defs/FilaVencimentoFaixaResumo"
            },
            "type": "array"
          },
          "tem_mais": {
            "default": false,
            "type": "boolean"
          },
          "total": {
            "type": "integer"
          }
        },
        "required": [
          "janela_dias",
          "total",
          "linhas"
        ],
        "title": "VMFilaVencimento",
        "type": "object"
      }
    },
    {
      "id": "vencimento_grafico",
      "label": "Curva de vencimento",
      "tamanho": "inteira",
      "viewmodel": {
        "$defs": {
          "VencimentoGraficoBalde": {
            "description": "Uma barra. `urgencia` posiciona na rampa: 0 tranquilo, 3 vencido.",
            "properties": {
              "inicio": {
                "type": "string"
              },
              "lotes": {
                "type": "integer"
              },
              "rotulo": {
                "type": "string"
              },
              "unidades": {
                "type": "integer"
              },
              "urgencia": {
                "type": "integer"
              }
            },
            "required": [
              "rotulo",
              "inicio",
              "lotes",
              "unidades",
              "urgencia"
            ],
            "title": "VencimentoGraficoBalde",
            "type": "object"
          }
        },
        "properties": {
          "baldes": {
            "items": {
              "$ref": "#/$defs/VencimentoGraficoBalde"
            },
            "type": "array"
          },
          "escopo": {
            "type": "string"
          },
          "horizonte_dias": {
            "type": "integer"
          },
          "legenda": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pico_rotulo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "total_lotes": {
            "type": "integer"
          }
        },
        "required": [
          "horizonte_dias",
          "escopo",
          "total_lotes",
          "pico_rotulo",
          "baldes",
          "legenda"
        ],
        "title": "VMVencimentoGrafico",
        "type": "object"
      }
    }
  ],
  "versao": 1
}
